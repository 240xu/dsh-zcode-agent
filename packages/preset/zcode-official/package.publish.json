{
  "name": "@deepseek-ai/dsh-zcode-official",
  "description": "ZCode preset plugin ported from the official open-source zai-org/ZCode (v3.14.0) sources: identity, dynamic behavior, env info, memory, plan workflow, and tool description builders. Apache-2.0 (official sources); see NOTICE-PORTED.md.",
  "version": "0.1.7-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/preset/zcode-official"
  },
  "type": "module",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-system-prompt": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/dsh-subagent": "*",
    "@deepseek-ai/dsh-jobs": "*",
    "@deepseek-ai/dsh-session-projection": "*",
    "@deepseek-ai/dsh-agent": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-session": "*",
    "@deepseek-ai/dsh-web": "*",
    "@deepseek-ai/dsh-util-values": "*",
    "@deepseek-ai/dsh-user-questions": "*",
    "@deepseek-ai/dsh-plan-mode": "*",
    "@deepseek-ai/dsh-compaction-basic": "*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-agent": "*",
    "@deepseek-ai/dsh-jobs": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-session-projection": "*",
    "@deepseek-ai/dsh-subagent": "*",
    "@deepseek-ai/dsh-system-prompt": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/dsh-session": "*",
    "@deepseek-ai/dsh-web": "*",
    "@deepseek-ai/dsh-util-values": "*",
    "@deepseek-ai/dsh-user-questions": "*",
    "@deepseek-ai/dsh-plan-mode": "*",
    "@deepseek-ai/dsh-compaction-basic": "*"
  },
  "files": [
    "NOTICE-PORTED.md",
    "README.md",
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "src/**/*"
  ]
}
